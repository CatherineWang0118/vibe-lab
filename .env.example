# 仅填写在服务端环境变量或本地 .env.local 中，切勿放入客户端代码或提交真实值。
COZE_WORKFLOW_ID={{填写自己的扣子工作流 ID}}
COZE_API_TOKEN={{填写自己的扣子个人访问令牌 PAT}}
MINIMAX_API_KEY={{填写自己的 MiniMax API Key}}

# 可选：你的 Coze 工作流主题输入字段名；默认 topic。
# COZE_TOPIC_PARAMETER=topic
# 可选：流式工作流等待时长（毫秒）。默认 600000，最大 600000。
# COZE_TIMEOUT_MS=600000
# 可选：仅 Coze 应用工作流填写 APP ID；需关联智能体资源的工作流填写 BOT ID。两者不能同时填写。
# COZE_APP_ID=
# COZE_BOT_ID=
# 可选：MiniMax 兼容端点或模型名。默认使用公开 API 的常用路径和模型名。
# MINIMAX_API_BASE_URL=https://api.minimax.chat
# MINIMAX_IMAGE_MODEL=image-01
# MINIMAX_VIDEO_MODEL=T2V-01-Director
